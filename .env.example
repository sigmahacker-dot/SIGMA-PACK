# Sigma Pack — environment variables
# Copy to .env.local (local dev) or set in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values. Generate secrets with: openssl rand -hex 32

# Neon Postgres connection string (pooled). Get it from https://neon.tech → project → Connection Details.
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# JWT signing secret — at least 32 random chars. Generate: openssl rand -hex 32
JWT_SECRET=

# AES-256-GCM key for encrypting buyer tool credentials — 64 hex chars (32 bytes). Generate: openssl rand -hex 32
CREDENTIALS_KEY=
